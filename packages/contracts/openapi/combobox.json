{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Meridian Combobox async-search data contract",
    "version": "1.0.0",
    "summary": "Instrument lookup for the asynchronous Combobox.",
    "description": "Interface contract for the async-search Combobox delivery. The listbox options come from the search operation and a committed selection is re-read by id. Handlers are generated from this document only.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Shares the zero-backend delivery origin with the DataTable contract."
    }
  ],
  "tags": [
    {
      "name": "instruments",
      "description": "Instrument reference data for async search."
    }
  ],
  "paths": {
    "/api/v1/instruments/search": {
      "get": {
        "operationId": "searchInstruments",
        "tags": [
          "instruments"
        ],
        "summary": "Search instruments by free text",
        "description": "Case-insensitive substring match over label, value and group. An empty or absent q returns every instrument in the reference book.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Typed query. The Combobox debounces this and aborts superseded requests.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "apple",
                "futures",
                "usd"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching options.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentSearchResponse"
                },
                "examples": {
                  "full": {
                    "$ref": "#/components/examples/InstrumentsCollection"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/instruments/{id}": {
      "get": {
        "operationId": "getInstrument",
        "tags": [
          "instruments"
        ],
        "summary": "Read a single instrument",
        "description": "Re-reads a committed selection. The mock serves the record from the declared reference book, matched on id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Instrument identifier.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The instrument.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Instrument"
                },
                "examples": {
                  "first": {
                    "$ref": "#/components/examples/InstrumentApple"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Shared problem envelope for every non-2xx response in the harness contracts.",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Stable, machine-readable problem code the DataTable surfaces in its error state.",
            "examples": [
              "invalid_parameter",
              "validation_failed",
              "not_found"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Operator-readable sentence. Never the only error signal in the UI (colour is paired with wording)."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request parameter or body property the problem is attributed to, or null when it is not."
          },
          "requestId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Correlation identifier echoed back by the gateway; null when the origin has none."
          }
        }
      },
      "Instrument": {
        "type": "object",
        "description": "Option row of the asynchronous-search Combobox.",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "value",
          "group"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable identifier the Combobox binds as the option item id."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable name shown in the listbox."
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Z][A-Z.\\-]{1,11}$",
            "description": "Instrument code committed on selection."
          },
          "group": {
            "type": [
              "string",
              "null"
            ],
            "description": "Asset class used for option groups; null renders in the ungrouped section."
          }
        }
      },
      "InstrumentSearchResponse": {
        "type": "object",
        "description": "Result of an asynchronous Combobox search.",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Instrument"
            },
            "description": "Options the listbox renders, already narrowed by the typed query; an empty array is a valid answer and renders the empty state."
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request carries a query parameter or body property that violates its declared schema.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "invalid_parameter",
              "message": "The instruments request sends a value outside its declared schema.",
              "field": null,
              "requestId": null
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource addressed by the request does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "not_found",
              "message": "No instrument matches the requested identifier.",
              "field": null,
              "requestId": null
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "The request is well-formed but the origin cannot act on it.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "validation_failed",
              "message": "The query cannot be processed against the instrument reference book.",
              "field": "q",
              "requestId": null
            }
          }
        }
      },
      "InternalServerError": {
        "description": "The origin failed. The component keeps its previous rows and renders the error state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "internal_error",
              "message": "The instrument service is temporarily unavailable.",
              "field": null,
              "requestId": null
            }
          }
        }
      }
    },
