{
  "name": "@designharness/contracts",
  "version": "0.1.0",
  "description": "Interface and zero-backend delivery layer: OpenAPI 3.1 contracts, MSW 3 handlers generated by @msw/source, component prop metadata and runtime schema guards.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/node-adapter.d.ts",
      "import": "./dist/node-adapter.js",
      "default": "./dist/node-adapter.js"
    },
    "./browser": {
      "types": "./dist/browser-adapter.d.ts",
      "import": "./dist/browser-adapter.js",
      "default": "./dist/browser-adapter.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./openapi/*": "./openapi/*",
    "./generated/*": "./generated/*"
  },
  "files": [
    "dist",
    "openapi",
    "generated"
  ],
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@designharness/engine": "workspace:*",
    "@designharness/ui": "workspace:*",
    "@msw/source": "catalog:",
    "msw": "catalog:",
    "zod": "catalog:",
    "openapi-types": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "openapi-types": "catalog:",
    "jsdom": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:"
  }
}
