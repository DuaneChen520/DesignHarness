{
  "name": "designharness",
  "version": "0.1.0",
  "description": "Unified Design System Harness CLI: build tokens, lint intent, extract metadata, serve registry, run gates, start MCP.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "dh": "dist/index.js",
    "designharness": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@designharness/engine": "workspace:*",
    "@designharness/registry": "workspace:*",
    "@designharness/mcp": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:"
  }
}
