{
  "name": "@designharness/ui",
  "version": "0.1.0",
  "description": "Tokenized production components built on the primitives, with CSF 3.0 stories and token-only styling.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*.css": "./*.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "lint": "eslint src && stylelint \"src/**/*.css\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@designharness/primitives": "workspace:*",
    "@designharness/tokens": "workspace:*",
    "@ark-ui/react": "catalog:",
    "@zag-js/react": "catalog:",
    "@zag-js/combobox": "catalog:",
    "@zag-js/dialog": "catalog:",
    "@zag-js/pagination": "catalog:",
    "@zag-js/toggle": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "jsdom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "stylelint": "catalog:",
    "@designharness/stylelint-plugin": "workspace:*"
  }
}
