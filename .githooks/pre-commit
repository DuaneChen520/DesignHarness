#!/bin/sh
# Tier-1 pre-commit hook: runs the AST sensors before a commit is created.
#
# Install with `git config core.hooksPath .githooks` (see README), or run the same sensor
# on demand with `pnpm gate:tier1`. Windows-friendly on purpose: the hook only calls `node`.
set -eu
exec node tooling/gates/tier1-precommit.mjs
