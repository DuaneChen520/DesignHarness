{
  "name": "design-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design System Harness — token-driven, headless, contract-verified design system engineering base.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.11 || ^24 || >=26"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "gate:tier1": "node tooling/gates/tier1-precommit.mjs",
    "gate:tier2": "node tooling/gates/tier2-designmd.mjs",
    "gate:tier3": "node tooling/gates/tier3-standard.mjs",
    "gate:tier4": "node tooling/gates/tier4-release.mjs",
    "verify": "node tooling/gates/verify-all.mjs",
    "tokens": "pnpm --filter @designharness/tokens build",
    "dh": "node packages/cli/dist/index.js",
    "designharness": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "designharness": "workspace:*",
    "@changesets/cli": "catalog:",
    "@designharness/stylelint-plugin": "workspace:*",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "stylelint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
